<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Makes the app show on CarPlay in every car (as an audio app). -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- When Apple approves your CarPlay VIDEO entitlement (iOS 27), add the key
	     Apple gives you here as well. Xcode adds it for you when you turn on the
	     CarPlay capability in Signing & Capabilities. -->
</dict>
</plist>
